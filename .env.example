# Sugar Plant Predictive Maintenance System - Environment Configuration Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# --- Flask Settings ---
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-long-random-secret-key

# --- MySQL Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sugar_plant_maintenance
DB_USER=your_db_username
DB_PASSWORD=your_db_password

# Assembled SQLAlchemy URI (used by Flask-SQLAlchemy)
# SQLALCHEMY_DATABASE_URI=mysql+pymysql://your_db_username:your_db_password@127.0.0.1:3306/sugar_plant_maintenance

# --- Email Notifications (SMTP) ---
# Example for Gmail:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_USE_TLS=true
EMAIL_FROM=SugarPlant PM <your-email@gmail.com>

# --- SMS Notifications (Twilio) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+12345678901


